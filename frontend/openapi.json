  "/api/recipes": {
   "get": {
    "tags": [
     "recipes"
    ],
    "summary": "List Recipes",
    "operationId": "list_recipes_api_recipes_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 200,
       "default": "",
       "title": "Q"
      }
     },
     {
      "name": "tag",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "maxLength": 40,
       "default": "",
       "title": "Tag"
      }
     },
     {
      "name": "owner",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "format": "uuid"
        },
        {
         "type": "null"
        }
       ],
       "title": "Owner"
      }
     },
     {
      "name": "favorites",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false,
       "title": "Favorites"
      }
     },
     {
      "name": "sort",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "recent",
        "rating",
        "title",
        "quick"
       ],
       "type": "string",
       "default": "recent",
       "title": "Sort"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 1,
       "default": 24,
       "title": "Limit"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100000,
       "minimum": 0,
       "default": 0,
       "title": "Offset"
      }
     }
    ],
